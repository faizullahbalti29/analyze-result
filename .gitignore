# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data — MongoDB export / import JSON files
*.json
!package.json
!package-lock.json
!tsconfig.json
!eslint.config.mjs
results-analyzer.nineth.json
results-analyzer.tenth.json

# python — import scripts and tooling
*.py
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
